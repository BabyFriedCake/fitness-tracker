# Development-only values. Replace all values through the deployment platform's
# secret manager before using this compose file outside local development.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://fitness_tracker:replace-with-a-local-password@public-content-postgres:5432/fitness_tracker
ADMIN_JWT_SECRET=replace-with-a-development-secret-at-least-32-characters
# Production JWKS alternative:
# ADMIN_JWT_SECRET=
# ADMIN_JWKS_URL=https://issuer.example/.well-known/jwks.json
# ADMIN_JWT_ISSUER=https://issuer.example/
# ADMIN_JWT_AUDIENCE=fitness-tracker-admin
